{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frogmap-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "build.mjs",
        "--dev"
      ],
      "port": 8000
    },
    {
      "name": "frogmap-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8001",
        "-d",
        "dist"
      ],
      "port": 8001
    }
  ]
}
